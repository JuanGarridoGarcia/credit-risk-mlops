# Copy to .env and replace the values. .env is git-ignored and never enters the image.
# docker compose reads this file; the Python settings read the same variables.

POSTGRES_DB=credit_risk
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=change-me
# Host port where Postgres is published on this machine (inside compose it is always 5432).
POSTGRES_PORT=5432
# Host the Python code connects to: localhost from this machine.
POSTGRES_HOST=localhost
# MLflow tracking server of docker compose (D-079), published on this machine only.
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
# Prefect server of docker compose (D-099), published on this machine only.
PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api
# Prediction API of docker compose (D-008), published on this machine only.
API_PORT=8000
API_URL=http://localhost:8000
# API keys (D-118), name:key pairs separated by commas; several may be valid at once
# (rotation). Keys of at least 32 characters; these are development values only: make
# your own with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
API_KEYS_PREDICT=replayer:dev-predict-key-0123456789abcdefghij
API_KEYS_ADMIN=flow:dev-admin-key-0123456789abcdefghijkl
# The keys the clients use: the flow (reload) and the replayer (predictions).
API_ADMIN_KEY=dev-admin-key-0123456789abcdefghijkl
API_PREDICT_KEY=dev-predict-key-0123456789abcdefghij
# Grafana of docker compose (D-147 to D-155), published on this machine only. The admin
# logs in with this password; Grafana reads Postgres as grafana_reader (read only, D-155),
# whose password `make migrate` sets. Development values only.
GRAFANA_PORT=3000
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=dev-grafana-admin-0123456789
GRAFANA_DB_PASSWORD=dev-grafana-reader-0123456789
# Telegram (D-148): the token of your bot (@BotFather) and the id of your chat with it.
# Leave them empty and Grafana starts with no channel; the dashboards work the same.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
