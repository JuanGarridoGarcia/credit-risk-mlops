{
  "uid": "credit-risk-system",
  "title": "Credit risk: System",
  "description": "Does it work? Months processed, tasks, the API and the alerts (D-152).",
  "tags": [
    "credit-risk"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "2013-06-01T00:00:00.000Z",
    "to": "2019-01-31T00:00:00.000Z"
  },
  "timepicker": {},
  "timezone": "utc",
  "refresh": "1m",
  "links": [
    {
      "title": "System",
      "url": "/d/credit-risk-system",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Data",
      "url": "/d/credit-risk-data",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Model",
      "url": "/d/credit-risk-model",
      "type": "link",
      "icon": "dashboard"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Monthly flow (simulated months)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Months loaded",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "description": "Simulated months whose load task completed.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT period) AS \"months\"\nFROM ops.task_runs\nWHERE task = 'load' AND state = 'completed' AND $__timeFilter(period)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Failed attempts",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "description": "Task attempts that failed (a retried one counts each time, D-102).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"failed attempts\"\nFROM ops.task_runs\nWHERE state = 'failed' AND $__timeFilter(period)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Last month processed",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "description": "The latest simulated month the flow loaded.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(period), 'YYYY-MM') AS \"month\"\nFROM ops.task_runs\nWHERE task = 'load' AND state = 'completed'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Open errors (7 days)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "description": "Alerts of severity error recorded in the last 7 days (real time).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"errors\"\nFROM ops.alerts\nWHERE severity = 'error' AND at > now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Seconds per task and month",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "description": "Time spent by each task of the monthly flow, all attempts (D-154).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT period::timestamptz AS time, task AS metric, sum(seconds) AS value\nFROM ops.task_runs\nWHERE $__timeFilter(period)\nGROUP BY period, task\nORDER BY period"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "row",
      "title": "Prediction API (real time, last 7 days)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Latency of the predictions, p95 (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "description": "95th percentile of the latency by hour, one loan (/predict) and a batch (/predict/batch, the replayer).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', at) AS time, endpoint AS metric,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS value\nFROM serving.requests\nWHERE $__timeFilter(at) AND endpoint IN ('/predict', '/predict/batch')\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "7d"
    },
    {
      "id": 9,
      "title": "Answers by status",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "description": "Requests per hour by class of status: 5xx are errors of the API.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', at) AS time,\n       CASE WHEN status >= 500 THEN '5xx' WHEN status >= 400 THEN '4xx' ELSE '2xx' END\n           AS metric,\n       count(*) AS value\nFROM serving.requests\nWHERE $__timeFilter(at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {},
      "timeFrom": "7d"
    },
    {
      "id": 10,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Latest alerts",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "description": "Every event recorded in ops.alerts (D-108, D-149); warnings and errors also go to Telegram (D-148).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT at AS \"recorded\", to_char(period, 'YYYY-MM') AS \"month\", severity, kind,\n       message\nFROM ops.alerts\nORDER BY alert_id DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "error": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      },
                      "info": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Training sets",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "description": "Every training set version built (D-058).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(cutoff, 'YYYY-MM') AS \"cutoff\", left(version, 12) AS \"version\",\n       rows_train AS \"train\", rows_validation AS \"validation\",\n       bad_train AS \"bad (train)\", bad_validation AS \"bad (validation)\", built_at\nFROM ops.training_sets\nORDER BY cutoff DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
