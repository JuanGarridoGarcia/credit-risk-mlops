      "id": 13,
      "title": "Changes of champion",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "description": "Every promotion and rollback (D-108), and the LGD versions that needed a large level correction (D-151).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(period, 'YYYY-MM') AS \"month\", kind, model, previous AS \"from\",\n       version AS \"to\", message\nFROM ops.alerts\nWHERE kind IN ('promoted', 'rolled_back', 'lgd_level_shift')\nORDER BY alert_id DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
