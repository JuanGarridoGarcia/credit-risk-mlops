    {
      "id": 8,
      "title": "AUC of each matured cohort",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "description": "Alert when the whole interval is below the validation AUC minus 0.01.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated::timestamptz AS time, auc AS \"AUC\", auc_low AS \"95% low\",\n       auc_high AS \"95% high\"\nFROM monitoring.performance\nWHERE segment = 'all' AND $__timeFilter(evaluated)\nORDER BY evaluated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 3
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Calibration and LGD level",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "description": "Calibration error alerts when its whole interval is above 0.01; the LGD level error beyond 0.15.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated::timestamptz AS time, calibration_error AS \"PD calibration error\",\n       lgd_level AS \"LGD level error\"\nFROM monitoring.performance\nWHERE segment = 'all' AND $__timeFilter(evaluated)\nORDER BY evaluated"
