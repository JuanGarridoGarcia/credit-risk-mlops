      "title": "Realised return of what was bought",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "description": "What the simulated investor got back over what it put in, per matured cohort.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated::timestamptz AS time, realised_return AS \"realised return\"\nFROM monitoring.performance\nWHERE segment = 'all' AND $__timeFilter(evaluated)\nORDER BY evaluated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "By grade, latest matured cohort",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "credit-risk-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "description": "Mean PD against the observed default rate, grade by grade.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT segment, loans, defaults, round(auc::numeric, 3) AS \"AUC\",\n       round(mean_pd::numeric, 3) AS \"mean PD\", round(default_rate::numeric, 3)\n           AS \"default rate\"\nFROM monitoring.performance\nWHERE evaluated = (SELECT max(evaluated) FROM monitoring.performance)\nORDER BY segment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
