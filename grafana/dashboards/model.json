          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated::timestamptz AS time, ratio AS \"ratio\", ratio_low AS \"95% low\",\n       ratio_high AS \"95% high\"\nFROM monitoring.early_warning\nWHERE term = 36 AND $__timeFilter(evaluated)\nORDER BY evaluated"
