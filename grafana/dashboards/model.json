            "uid": "credit-risk-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT period::timestamptz AS time, max(psi) AS \"lgd\"\nFROM monitoring.drift\nWHERE subject = 'lgd' AND $__timeFilter(period)\nGROUP BY period\nORDER BY period"
        }
      ],
      "fieldConfig": {
